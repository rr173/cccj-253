{
  "format": "slot-catalog-scenario/1",
  "name": "02-chain-switch",
  "steps": [
    {
      "batch": {
        "batch_id": "SETUP",
        "ops": [
          {"op": "add_booklet", "booklet": "B1", "slot_width": 4},
          {"op": "register", "booklet": "B1", "part": "A", "title": "旧件甲", "body": "甲的正文", "approved": true},
          {"op": "register", "booklet": "B1", "part": "B", "title": "旧件乙", "body": "乙的正文", "approved": true},
          {"op": "register", "booklet": "B1", "part": "C", "title": "现行件丙", "body": "丙的正文", "approved": true},
          {"op": "register", "booklet": "B1", "part": "D", "title": "未审件丁", "body": "丁的正文", "approved": true},
          {"op": "publish", "version": "V1"}
        ]
      }
    },
    {
      "batch": {
        "batch_id": "CHAIN-ABC",
        "ops": [
          {"op": "replace", "booklet": "B1", "old": "A", "new": "B"},
          {"op": "replace", "booklet": "B1", "old": "B", "new": "C"}
        ]
      }
    },
    {"query_slot": {"version": "V1", "booklet": "B1", "slot": 0}},
    {"query_slot": {"version": "V1", "booklet": "B1", "slot": 1}},
    {"search_export": {"booklet": "B1"}},
    {
      "batch": {
        "batch_id": "SWITCH-TO-INVISIBLE-D",
        "ops": [
          {"op": "set_review", "booklet": "B1", "part": "D", "approved": false},
          {"op": "unreplace", "booklet": "B1", "old": "B"},
          {"op": "replace", "booklet": "B1", "old": "B", "new": "D"}
        ]
      }
    },
    {"query_slot": {"version": "V1", "booklet": "B1", "slot": 0}},
    {"query_slot": {"version": "V1", "booklet": "B1", "slot": 1}},
    {"query_slot": {"version": "V1", "booklet": "B1", "slot": 2}},
    {"search_export": {"booklet": "B1"}}
  ]
}
